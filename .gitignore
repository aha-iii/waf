/target/
**/node_modules/
**/dist/
/dist/
*.tsbuildinfo

# Local env & secrets（根目录 .env.example 与 scripts/*.local.env.example 可提交）
.env
.env.*
!.env.example
**/*.local.env
!**/*.local.env.example
deploy/.env
