# 复制为 .env：cp .env.example .env
#
# mars-test 发布（WSL 推荐）：
#   bash scripts/deploy-runtime-to-test.sh --up
# Windows（无 WSL，需 OpenSSH + tar）：
#   powershell -File scripts/deploy-runtime-to-test-win.ps1 -Up
#
# 测试包特性（--test / pack-dist-runtime-test.ps1）：
#   - 剔除 ssrf-internal-ip、ssrf-loopback 规则
#   - 发布后自动关闭 CC / GEO / BOT 默认开关

TAG=1.0.0

# Console / 控制面 API（容器内仍 8781，宿主机映射 9999）
PORT=9999

# WAF Console 独立进程（容器内 8782，宿主机映射 8782）
CONSOLE_PORT=8782

# Edge 直连调试口（IIS 应走 NGINX_PORT=9888，不要直连此口）
EDGE_PORT=9889

# IIS → 此端口；Nginx 剥 X-Original-URL 后转发 Edge（容器内 nerve-waf-edge:8080）
NGINX_PORT=9888

# 官网静态站（nginx-official）
OFFICIAL_PORT=9887

# 告警 API（nerve-alert）
ALERT_PORT=8790
NERVE_ALERT_URL=http://nerve-alert:8790
NERVE_ALERT_ENABLED=1

TZ=Asia/Shanghai

NERVE_AUTH_ENABLED=1
NERVE_AUTH_MODE=local
NERVE_API_KEY=dev-nerve-key

# Console 登录页 demo 模式预填的账号；首次启动无可用账号时会自动创建为 bootstrap admin
# （与 apps/console-react/src/pages/LoginPage.tsx 中的 DEMO_USERNAME/DEMO_PASSWORD 保持一致）
NERVE_AUTH_BOOTSTRAP_USER=lucongming_0108
NERVE_AUTH_BOOTSTRAP_PASSWORD=@Lucongming0108

# PostgreSQL 连接串，必须指向 mars-test 独立数据库；
# 请不要复用生产数据库或正式环境配置。
# 例: postgres://postgres:change-me@127.0.0.1:5432/nerve
DATABASE_URL=postgres://postgres:change-me@127.0.0.1:5432/nerve

NERVE_URL=
NERVE_GATEWAY_ADMIN_URL=
NERVE_GATEWAY_DASHBOARD_URL=

NERVE_EXPERT_ENGINE=on
NERVE_EXPERT_PACK=/opt/nerve/native/baseline
NERVE_NATIVE_DEV_PACK=1

# Edge 内联代理：Deep 预算封顶、同步 Fast、异步 Shadow Deep
NERVE_NATIVE_EDGE_INLINE=1
NERVE_NATIVE_MAX_INSPECT_MS=300
NERVE_NATIVE_SHADOW_DEEP=1
# 多进程 Edge（对标 nginx worker_processes auto + SO_REUSEPORT）
NERVE_EDGE_REUSEPORT=1
NERVE_EDGE_WORKERS=auto
# NERVE_EDGE_TIMING_ALL=1
# Inspect 节点明细（开发调试；生产可关）
NERVE_INSPECT_TRACE=1
NERVE_INSPECT_TRACE_LOG=1
# NERVE_INSPECT_TRACE_MIN_US=1000

# --- AI / 研判（API 二进制已含路由；LLM 需外部 OpenAI 兼容端点才就绪）---
NERVE_ENGRAM_URL=http://nerve-engram:8795
ENGRAM_PORT=8795
ENGRAM_MODEL_ID=engram-waf-v1
# NERVE_LLM_ENABLED=1
# NERVE_LLM_AUTO_EXPLAIN=1
# NERVE_LLM_API_URL=https://your-llm/v1/chat/completions
# NERVE_LLM_API_KEY=
# NERVE_LLM_MODEL=gpt-4o-mini

RUST_LOG=info,inspect_trace=info
