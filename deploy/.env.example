# Nerve WAF — Docker Compose 环境变量
# 复制为 deploy/.env 后可覆盖默认值。
# 一键启动: bash scripts/up.sh（在 deploy/ 目录）
# 架构说明: deploy/TOPOLOGY.md
#
# ⚠ 下列默认值仅用于本地开发，禁止原样用于生产。

TAG=1.0.0
PORT=9000
CONSOLE_PORT=9090
WAF_AGENT_PORT=9080
TZ=Asia/Shanghai

POSTGRES_USER=postgres
POSTGRES_PASSWORD=nerve_waf_dev
POSTGRES_DB=nerve
POSTGRES_PORT=5432

# Compose 网络内主机名 postgres；使用外置库时请改掉整串 URL。
DATABASE_URL=postgres://postgres:nerve_waf_dev@postgres:5432/nerve

# 本地开发可关闭；生产必须为 1（见 docs/runbooks/PRODUCTION.md）
NERVE_AUTH_ENABLED=0
NERVE_API_KEY=change-me-api-key

NERVE_EXPERT_ENGINE=off
NERVE_ALERT_ENABLED=0

RUST_LOG=info
