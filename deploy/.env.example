# Nerve WAF 测试环境 — 复制为 .env 后修改（仓库 deploy/.env 可直接用）

TAG=1.0.0
PORT=8781
EDGE_PORT=8080

# 容器与 API 日志时区
TZ=Asia/Shanghai

NERVE_AUTH_ENABLED=0
NERVE_API_KEY=dev-nerve-key

# 开启鉴权时默认自研登录（admin / admin，生产务必修改）
# NERVE_AUTH_ENABLED=1
# NERVE_AUTH_MODE=local
# NERVE_AUTH_USER=admin
# NERVE_AUTH_PASSWORD=admin
# KEYCLOAK_ENABLED=0

DATABASE_URL=postgres://postgres:p@ssw0rd@192.168.10.16:5432/nerve

NERVE_URL=http://host.docker.internal:8766
NERVE_GATEWAY_ADMIN_URL=
NERVE_GATEWAY_DASHBOARD_URL=

# 专家防护（镜像内已 COPY baseline；sealed 包生产环境改路径并关 NERVE_NATIVE_DEV_PACK）
NERVE_EXPERT_ENGINE=on
NERVE_EXPERT_PACK=/opt/nerve/native/baseline
NERVE_NATIVE_DEV_PACK=1

# 仅镜像构建 Console 时使用（docker build --build-arg VITE_CONSOLE_TIME_ZONE=Asia/Shanghai）
VITE_CONSOLE_TIME_ZONE=Asia/Shanghai

RUST_LOG=info
