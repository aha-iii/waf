# Nerve WAF — test/deploy environment variables (copy to `.env` and change placeholders).
# Purpose: docker-compose / local test stack. Do not commit real secrets.
# 测试环境变量示例：复制为 .env 后按需修改占位符。

TAG=1.0.0
PORT=8781
EDGE_PORT=8080
TZ=Asia/Shanghai

# Local: auth may be off. Production: set NERVE_AUTH_ENABLED=1 and rotate keys.
# 本地可先关鉴权；生产务必 NERVE_AUTH_ENABLED=1 并更换密钥
NERVE_AUTH_ENABLED=0
NERVE_API_KEY=change-me-api-key

# When auth is on, optional local bootstrap user (change in production).
# 开启鉴权时可用本地账号（生产务必修改）
# NERVE_AUTH_ENABLED=1
# NERVE_AUTH_MODE=local
# NERVE_AUTH_BOOTSTRAP_USER=admin
# NERVE_AUTH_BOOTSTRAP_PASSWORD=change-me
# KEYCLOAK_ENABLED=0

# Replace with your PostgreSQL URL (placeholder password must be changed).
# 改成你的 PostgreSQL
DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/nerve

NERVE_URL=http://host.docker.internal:8766
NERVE_GATEWAY_ADMIN_URL=
NERVE_GATEWAY_DASHBOARD_URL=

NERVE_EXPERT_ENGINE=on
NERVE_EXPERT_PACK=/opt/nerve/native/baseline
NERVE_NATIVE_DEV_PACK=1

VITE_CONSOLE_TIME_ZONE=Asia/Shanghai
RUST_LOG=info
