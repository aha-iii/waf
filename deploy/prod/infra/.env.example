# 复制为 .env：cp .env.example .env
#
# 由 scripts/deploy-prod-infra.sh 同步到远端 DEPLOY_INFRA_DIR

TZ=Asia/Shanghai

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=nerve

# APISIX 公网入口（容器内 9080/9443）
APISIX_HTTP_PORT=80
APISIX_HTTP_ALT_PORT=9080
APISIX_HTTPS_PORT=443
# Admin + 内嵌 Dashboard（/ui/）；安全组务必限制源 IP，勿对 0.0.0.0/0 长期开放
APISIX_ADMIN_PORT=9180

# 须与 apisix/config.yaml 中 admin_key.key 一致
APISIX_ADMIN_KEY=edd1c9f034335f136f87ad84b625c8f1

# 路由 Host（apply-apisix-routes.sh 读取）
WAF_DOMAIN=waf.ahatec.com.cn
ALERT_DOMAIN=alert.ahatec.com.cn
WWW_DOMAIN=www.ahatec.com.cn
ROOT_DOMAIN=ahatec.com.cn
GIT_DOMAIN=git.ahatec.com.cn
