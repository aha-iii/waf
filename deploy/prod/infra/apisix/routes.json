{
  "routes": [
    {
      "id": "ddos-host",
      "name": "ddos-host",
      "host": "${DDOS_DOMAIN}",
      "uri": "/*",
      "priority": 200,
      "upstream": {
        "type": "roundrobin",
        "nodes": { "nerve-ddos-console:80": 1 },
        "pass_host": "pass",
        "scheme": "http"
      },
      "plugins": {
        "response-rewrite": {
          "headers": {
            "set": {
              "X-Content-Type-Options": "nosniff",
              "X-Frame-Options": "SAMEORIGIN",
              "Referrer-Policy": "strict-origin-when-cross-origin",
              "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
              "Permissions-Policy": "geolocation=(), microphone=(), camera=()",
              "Server": "Nerve"
            }
          }
        }
      }
    },
    {
      "id": "alert-host",
      "name": "alert-host",
      "host": "${ALERT_DOMAIN}",
      "uri": "/*",
      "priority": 200,
      "upstream": {
        "type": "roundrobin",
        "nodes": { "nerve-alert:8790": 1 },
        "pass_host": "pass",
        "scheme": "http"
      },
      "plugins": {
        "response-rewrite": {
          "headers": {
            "set": {
              "X-Content-Type-Options": "nosniff",
              "X-Frame-Options": "SAMEORIGIN",
              "Referrer-Policy": "strict-origin-when-cross-origin",
              "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
              "Permissions-Policy": "geolocation=(), microphone=(), camera=()",
              "Server": "Nerve"
            }
          }
        }
      }
    },
    {
      "id": "www-official",
      "name": "www-official",
      "host": "${WWW_DOMAIN}",
      "uri": "/*",
      "priority": 200,
      "upstream": {
        "type": "roundrobin",
        "nodes": { "nerve-official:80": 1 },
        "pass_host": "pass",
        "scheme": "http",
        "retries": 2,
        "retry_timeout": 5,
        "timeout": { "connect": 5, "send": 30, "read": 30 },
        "keepalive_pool": { "size": 16, "idle_timeout": 60, "requests": 1000 }
      },
      "plugins": {
        "response-rewrite": {
          "headers": {
            "set": {
              "X-Content-Type-Options": "nosniff",
              "X-Frame-Options": "SAMEORIGIN",
              "Referrer-Policy": "strict-origin-when-cross-origin",
              "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
              "Permissions-Policy": "geolocation=(), microphone=(), camera=()",
              "Server": "Nerve"
            }
          }
        }
      }
    },
    {
      "id": "apex-official",
      "name": "apex-official",
      "host": "${ROOT_DOMAIN}",
      "uri": "/*",
      "priority": 200,
      "upstream": {
        "type": "roundrobin",
        "nodes": { "nerve-official:80": 1 },
        "pass_host": "pass",
        "scheme": "http",
        "retries": 2,
        "retry_timeout": 5,
        "timeout": { "connect": 5, "send": 30, "read": 30 },
        "keepalive_pool": { "size": 16, "idle_timeout": 60, "requests": 1000 }
      },
      "plugins": {
        "response-rewrite": {
          "headers": {
            "set": {
              "X-Content-Type-Options": "nosniff",
              "X-Frame-Options": "SAMEORIGIN",
              "Referrer-Policy": "strict-origin-when-cross-origin",
              "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
              "Permissions-Policy": "geolocation=(), microphone=(), camera=()",
              "Server": "Nerve"
            }
          }
        }
      }
    },
    {
      "id": "waf-api-login",
      "name": "waf-api-login",
      "host": "${WAF_DOMAIN}",
      "uri": "/api/auth/login",
      "priority": 150,
      "methods": ["POST", "OPTIONS"],
      "upstream": {
        "type": "roundrobin",
        "nodes": { "nerve-waf-api:8781": 1 },
        "pass_host": "pass",
        "scheme": "http"
      },
      "plugins": {
        "limit-count": {
          "count": 20,
          "time_window": 60,
          "rejected_code": 429,
          "key_type": "var",
          "key": "remote_addr",
          "policy": "local"
        },
        "cors": {
          "allow_origins": "https://${WAF_DOMAIN}",
          "allow_methods": "POST,OPTIONS",
          "allow_headers": "Authorization,Content-Type,X-Api-Key,Accept,Origin",
          "max_age": 600,
          "allow_credential": true
        },
        "response-rewrite": {
          "headers": {
            "set": {
              "Server": "Nerve",
              "X-Content-Type-Options": "nosniff",
              "X-Frame-Options": "DENY",
              "Referrer-Policy": "no-referrer",
              "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
            },
            "remove": ["Nerve-Trace-Id", "Nerve-Span-Id", "X-Trace-Id"]
          }
        }
      }
    },
    {
      "id": "waf-api",
      "name": "waf-api",
      "host": "${WAF_DOMAIN}",
      "uri": "/api*",
      "priority": 100,
      "upstream": {
        "type": "roundrobin",
        "nodes": { "nerve-waf-api:8781": 1 },
        "pass_host": "pass",
        "scheme": "http"
      },
      "plugins": {
        "response-rewrite": {
          "headers": {
            "set": {
              "Server": "Nerve",
              "X-Content-Type-Options": "nosniff",
              "X-Frame-Options": "DENY",
              "Referrer-Policy": "strict-origin-when-cross-origin",
              "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
              "Permissions-Policy": "geolocation=(), microphone=(), camera=()"
            },
            "remove": ["Nerve-Trace-Id", "Nerve-Span-Id", "X-Trace-Id", "tracestate"]
          }
        },
        "cors": {
          "allow_origins": "https://${WAF_DOMAIN}",
          "allow_methods": "GET,POST,PUT,DELETE,PATCH,OPTIONS,HEAD",
          "allow_headers": "Authorization,Content-Type,X-Api-Key,Accept,Origin",
          "expose_headers": "Content-Length,Content-Type",
          "max_age": 600,
          "allow_credential": true
        }
      }
    },
    {
      "id": "waf-console",
      "name": "waf-console",
      "host": "${WAF_DOMAIN}",
      "uri": "/console*",
      "priority": 100,
      "upstream": {
        "type": "roundrobin",
        "nodes": { "nerve-waf-console:8782": 1 },
        "pass_host": "pass",
        "scheme": "http"
      },
      "plugins": {
        "proxy-rewrite": {
          "regex_uri": ["^/console/?(.*)", "/$1"]
        },
        "response-rewrite": {
          "headers": {
            "set": {
              "X-Content-Type-Options": "nosniff",
              "X-Frame-Options": "SAMEORIGIN",
              "Referrer-Policy": "strict-origin-when-cross-origin",
              "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
              "Server": "Nerve"
            }
          }
        }
      }
    },
    {
      "id": "waf-assets",
      "name": "waf-assets",
      "host": "${WAF_DOMAIN}",
      "uri": "/assets*",
      "priority": 100,
      "upstream": {
        "type": "roundrobin",
        "nodes": { "nerve-waf-console:8782": 1 },
        "pass_host": "pass",
        "scheme": "http"
      },
      "plugins": {
        "response-rewrite": {
          "headers": {
            "set": {
              "X-Content-Type-Options": "nosniff",
              "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
              "Server": "Nerve"
            }
          }
        }
      }
    },
    {
      "id": "waf-engram",
      "name": "waf-engram",
      "host": "${WAF_DOMAIN}",
      "uri": "/engram*",
      "priority": 100,
      "upstream": {
        "type": "roundrobin",
        "nodes": { "nerve-engram:8795": 1 },
        "pass_host": "pass",
        "scheme": "http"
      },
      "plugins": {
        "proxy-rewrite": {
          "regex_uri": ["^/engram/?(.*)", "/$1"]
        },
        "response-rewrite": {
          "headers": {
            "set": {
              "X-Content-Type-Options": "nosniff",
              "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
              "Server": "Nerve"
            }
          }
        }
      }
    },
    {
      "id": "waf-fallback",
      "name": "waf-fallback",
      "host": "${WAF_DOMAIN}",
      "uri": "/*",
      "priority": 1,
      "upstream": {
        "type": "roundrobin",
        "nodes": { "nerve-waf-console:8782": 1 },
        "pass_host": "pass",
        "scheme": "http"
      },
      "plugins": {
        "response-rewrite": {
          "headers": {
            "set": {
              "X-Content-Type-Options": "nosniff",
              "X-Frame-Options": "SAMEORIGIN",
              "Referrer-Policy": "strict-origin-when-cross-origin",
              "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
              "Server": "Nerve"
            }
          }
        }
      }
    },
    {
      "id": "gitlab-host",
      "name": "gitlab-host",
      "host": "${GIT_DOMAIN}",
      "uri": "/*",
      "priority": 200,
      "upstream": {
        "type": "roundrobin",
        "nodes": { "gitlab:80": 1 },
        "pass_host": "pass",
        "scheme": "http"
      },
      "plugins": {
        "client-control": {
          "max_body_size": 268435456
        },
        "response-rewrite": {
          "headers": {
            "set": {
              "X-Content-Type-Options": "nosniff",
              "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
              "Server": "Nerve"
            }
          }
        }
      }
    }
  ]
}
