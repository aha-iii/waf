{
  "routes": [
    {
      "id": "alert-host",
      "name": "alert-host",
      "host": "${ALERT_DOMAIN}",
      "uri": "/*",
      "priority": 200,
      "upstream": {
        "type": "roundrobin",
        "nodes": { "nerve-alert:8790": 1 },
        "pass_host": "pass",
        "scheme": "http"
      }
    },
    {
      "id": "www-official",
      "name": "www-official",
      "host": "${WWW_DOMAIN}",
      "uri": "/*",
      "priority": 200,
      "upstream": {
        "type": "roundrobin",
        "nodes": { "nerve-official:80": 1 },
        "pass_host": "pass",
        "scheme": "http"
      }
    },
    {
      "id": "apex-official",
      "name": "apex-official",
      "host": "${ROOT_DOMAIN}",
      "uri": "/*",
      "priority": 200,
      "upstream": {
        "type": "roundrobin",
        "nodes": { "nerve-official:80": 1 },
        "pass_host": "pass",
        "scheme": "http"
      }
    },
    {
      "id": "waf-api",
      "name": "waf-api",
      "host": "${WAF_DOMAIN}",
      "uri": "/api*",
      "priority": 100,
      "upstream": {
        "type": "roundrobin",
        "nodes": { "nerve-waf-api:8781": 1 },
        "pass_host": "pass",
        "scheme": "http"
      }
    },
    {
      "id": "waf-console",
      "name": "waf-console",
      "host": "${WAF_DOMAIN}",
      "uri": "/console*",
      "priority": 100,
      "upstream": {
        "type": "roundrobin",
        "nodes": { "nerve-waf-console:8782": 1 },
        "pass_host": "pass",
        "scheme": "http"
      },
      "plugins": {
        "proxy-rewrite": {
          "regex_uri": ["^/console/?(.*)", "/$1"]
        }
      }
    },
    {
      "id": "waf-assets",
      "name": "waf-assets",
      "host": "${WAF_DOMAIN}",
      "uri": "/assets*",
      "priority": 100,
      "upstream": {
        "type": "roundrobin",
        "nodes": { "nerve-waf-console:8782": 1 },
        "pass_host": "pass",
        "scheme": "http"
      }
    },
    {
      "id": "waf-engram",
      "name": "waf-engram",
      "host": "${WAF_DOMAIN}",
      "uri": "/engram*",
      "priority": 100,
      "upstream": {
        "type": "roundrobin",
        "nodes": { "nerve-engram:8795": 1 },
        "pass_host": "pass",
        "scheme": "http"
      },
      "plugins": {
        "proxy-rewrite": {
          "regex_uri": ["^/engram/?(.*)", "/$1"]
        }
      }
    },
    {
      "id": "waf-edge",
      "name": "waf-edge",
      "host": "${WAF_DOMAIN}",
      "uri": "/*",
      "priority": 1,
      "upstream": {
        "type": "roundrobin",
        "nodes": { "nerve-waf-edge:8080": 1 },
        "pass_host": "pass",
        "scheme": "http"
      }
    }
  ]
}
