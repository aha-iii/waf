# 复制为 .env：cp .env.example .env
#
# DATABASE_URL 指向 infra 网络内 postgres 服务名（非公网 IP）

TAG=1.0.0
TZ=Asia/Shanghai

NERVE_AUTH_ENABLED=1
NERVE_AUTH_MODE=local
NERVE_API_KEY=change-me-api-key

# 与 infra/.env 中 POSTGRES_* 一致；主机名为 compose 服务名 postgres
DATABASE_URL=postgres://postgres:change-me-strong@postgres:5432/nerve

NERVE_ALERT_URL=http://nerve-alert:8790
NERVE_ALERT_ENABLED=1

NERVE_URL=
NERVE_GATEWAY_ADMIN_URL=
NERVE_GATEWAY_DASHBOARD_URL=

NERVE_EXPERT_ENGINE=on
NERVE_EXPERT_PACK=/opt/nerve/native/baseline
NERVE_NATIVE_DEV_PACK=0

NERVE_NATIVE_EDGE_INLINE=1
NERVE_NATIVE_MAX_INSPECT_MS=300
NERVE_NATIVE_SHADOW_DEEP=1
NERVE_EDGE_REUSEPORT=1
NERVE_EDGE_WORKERS=auto

# 正式默认关闭 inspect 节点明细；排障时改为 1
NERVE_INSPECT_TRACE=0
NERVE_INSPECT_TRACE_LOG=0

NERVE_ENGRAM_URL=http://nerve-engram:8795
ENGRAM_MODEL_ID=engram-waf-v1

# NERVE_LLM_ENABLED=0
# NERVE_LLM_API_URL=
# NERVE_LLM_API_KEY=
# NERVE_LLM_MODEL=

# 官网预约演示 → 企业微信群机器人 Webhook（留空则只写库不推送）
# DEMO_WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...

RUST_LOG=info
