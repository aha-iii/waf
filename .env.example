# Nerve WAF — optional environment overrides for config.yml (local / publishable sample).
# Product dir: Nerve-waf/; crate prefix: nerve-waf-*. Precedence: CLI / env > config.yml.
# Change placeholders (API keys, DB URL, secrets) before any non-dev use.
# 可选环境变量覆盖 config.yml；优先级：CLI / 环境变量 > config.yml。

# WAF_CONFIG=./config.yml
# WAF API :9000; topology belongs to Nerve-control :8780
PORT=9000
CONSOLE_PORT=9090
WAF_AGENT_PORT=9080
# NERVE_URL=http://127.0.0.1:8766
# NERVE_WAF_DATA=./data
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@127.0.0.1:5432/nerve

# --- Auth (on by default; local may set NERVE_AUTH_ENABLED=0) ---
# --- 鉴权（默认开启；本地可 NERVE_AUTH_ENABLED=0）---
NERVE_AUTH_ENABLED=1
NERVE_API_KEY=dev-nerve-key

# --- Local username/password login (Console default; accounts in waf_users) ---
# --- 自研账号密码登录（Console 默认；账号存 waf_users 表）---
# NERVE_AUTH_MODE=local
# NERVE_AUTH_JWT_SECRET=change-me-to-a-long-random-string
# NERVE_AUTH_TOKEN_TTL_SECS=86400
# NERVE_AUTH_LOCAL_ENABLED=0  # disable local login (API Key / Keycloak only)

# Emergency rollback only (do not enable in production): WAF_ENABLE_LEGACY_TOPOLOGY=1 / WAF_ENABLE_LEGACY_NP=1
# 紧急回滚（生产勿开）

# --- Nerve-alert (block-alert dispatch + Console /api/alerts proxy) ---
# NERVE_ALERT_URL=http://127.0.0.1:8790
# NERVE_ALERT_ENABLED=1
# Same compose network: http://nerve-alert:8790

# --- Coraza + CRS (WASM preferred; see wasm/README.md) ---
# NERVE_WAF_CRS_ENGINE=wasm
# NERVE_WAF_CORAZA_URL=http://127.0.0.1:8791

# --- Keycloak OIDC (optional; needs NERVE_AUTH_MODE=keycloak + KEYCLOAK_ENABLED=1) ---
KEYCLOAK_ENABLED=0
# KEYCLOAK_AUTH_SERVER_URL=http://keycloak.example/auth
# KEYCLOAK_REALM=nerve
# KEYCLOAK_CLIENT_ID=nerve-waf-console

# --- SaaS CNAME edge onboarding ---
# WAF_CNAME_ZONE=waf.example.com
# WAF_AGENT_IPS=203.0.113.10,203.0.113.11
# WAF_AGENT_EGRESS_CIDRS=203.0.113.0/24
# WAF_ACME_ENABLED=1
# Gateway Admin (WAF discovers upstreams / pushes routes)
# NERVE_GATEWAY_ADMIN_URL=http://127.0.0.1:9080
# NERVE_GATEWAY_DASHBOARD_URL=http://127.0.0.1:5176
