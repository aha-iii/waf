# Nerve WAF — 可选环境变量覆盖 config.yml
# 优先级：CLI / 环境变量 > config.yml

# WAF_CONFIG=./config.yml
# 拓扑归 Control :8780；WAF API 用 :8781
PORT=8781
# NERVE_URL=http://127.0.0.1:8766
# NERVE_WAF_DATA=./data
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@192.168.10.16:5432/nerve

# --- 鉴权（默认开启；本地可 NERVE_AUTH_ENABLED=0）---
NERVE_AUTH_ENABLED=1
NERVE_API_KEY=dev-nerve-key

# --- 自研账号密码登录（Console 默认；账号存 waf_users 表）---
# NERVE_AUTH_MODE=local
# NERVE_AUTH_JWT_SECRET=change-me-to-a-long-random-string
# NERVE_AUTH_TOKEN_TTL_SECS=86400
# NERVE_AUTH_LOCAL_ENABLED=0  # 关闭自研登录（仅用 API Key / Keycloak）

# 紧急回滚（生产勿开）：WAF_ENABLE_LEGACY_TOPOLOGY=1 / WAF_ENABLE_LEGACY_NP=1

# --- Nerve-alert（拦截告警 dispatch + Console /api/alerts 代理）---
# NERVE_ALERT_URL=http://127.0.0.1:8790
# NERVE_ALERT_ENABLED=1
# Docker 同 compose 内可用：http://nerve-alert:8790

# --- Coraza + CRS 全集（先启动 Nerve-waf/coraza-engine）---
# NERVE_WAF_CRS_ENGINE=coraza
# NERVE_WAF_CORAZA_URL=http://127.0.0.1:8791

# --- Keycloak OIDC（可选；需 NERVE_AUTH_MODE=keycloak + KEYCLOAK_ENABLED=1）---
KEYCLOAK_ENABLED=0
# KEYCLOAK_AUTH_SERVER_URL=http://keycloak.example/auth
# KEYCLOAK_REALM=nerve
# KEYCLOAK_CLIENT_ID=nerve-waf-console

# --- SaaS CNAME 边缘接入 ---
# WAF_CNAME_ZONE=waf.example.com
# WAF_EDGE_IPS=203.0.113.10,203.0.113.11
# WAF_EDGE_EGRESS_CIDRS=203.0.113.0/24
# WAF_ACME_ENABLED=1
# Gateway Admin（WAF 拉取上游 / 推送路由）
# NERVE_GATEWAY_ADMIN_URL=http://127.0.0.1:9080
# NERVE_GATEWAY_DASHBOARD_URL=http://127.0.0.1:5176
