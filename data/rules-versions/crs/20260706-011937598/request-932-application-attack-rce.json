{
  "pack_id": "request-932-application-attack-rce",
  "version": "4.25.0",
  "description": "核心规则集 imported from REQUEST-932-APPLICATION-ATTACK-RCE.conf (regex subset)",
  "enabled": true,
  "rollout_pct": 100,
  "rules": [
    {
      "id": "932140",
      "name": "Remote Command Execution: Windows FOR/IF Command Found",
      "pattern": "b(?:for(?:/[dflr].*)? %+[^ ]+ in(.*)[sx0b]?do|if(?:/i)?(?: not)?(?: (?:e(?:xist|rrorlevel)|defined|cmdextversion)b|[ (].*(?:b(?:g(?:eq|tr)|equ|neq|l(?:eq|ss))b|==)))",
      "category": "rce",
      "severity": "critical"
    },
    {
      "id": "932270",
      "name": "Remote Command Execution: Unix Shell Expression Found",
      "pattern": "~[+-](?:$|[0-9]+)",
      "category": "rce",
      "severity": "critical"
    },
    {
      "id": "932330",
      "name": "Remote Command Execution: Unix shell history invocation",
      "pattern": "!-d",
      "category": "rce",
      "severity": "critical",
      "paranoia_level": 1
    },
    {
      "id": "932240",
      "name": "Remote Command Execution: Unix Command Injection evasion attempt detected",
      "pattern": "(?i)[-0-9_a-z]+(?:[sx0b]*[\"'][^sx0b\"',:]+[\"']|(?:[\"'][\"']+|[[-]]+|$+[!#*-0-9?@x5c_a-{]+|``|[$<>]())[sx0b]*)[-0-9_a-z]+",
      "category": "rce",
      "severity": "high"
    },
    {
      "id": "932210",
      "name": "Remote Command Execution: SQLite System Command Execution",
      "pattern": ";[sx0b]*.[sx0b]*[\"']?(?:a(?:rchive|uth)|b(?:a(?:ckup|il)|inary)|c(?:d|h(?:anges|eck)|lone|onnection)|d(?:atabases|b(?:config|info)|ump)|e(?:cho|qp|x(?:cel|it|p(?:ert|lain)))|f(?:ilectrl|ullschema)|he(?:aders|lp)|i(?:mpo(?:rt|ster)|ndexes|otrace)|l(?:i(?:mi|n)t|o(?:ad|g))|(?:mod|n(?:onc|ullvalu)|unmodul)e|o(?:nce|pen|utput)|p(?:arameter|r(?:int|o(?:gress|mpt)))|quit|re(?:ad|cover|store)|s(?:ave|c(?:anstats|hema)|e(?:lftest|parator|ssion)|h(?:a3sum|ell|ow)?|tats|ystem)|t(?:ables|estc(?:ase|trl)|ime(?:out|r)|race)|vfs(?:info|list|name)|width)",
      "category": "rce",
      "severity": "high"
    },
    {
      "id": "932271",
      "name": "Remote Command Execution: Unix Shell Expression Found",
      "pattern": "~[0-9]+",
      "category": "rce",
      "severity": "high"
    },
    {
      "id": "932300",
      "name": "Remote Command Execution: SMTP Command Execution",
      "pattern": "(?i)rn.*?b(?:E(?:HLO[sx0b][-.a-z]{1,255}|XPN[sx0b].{1,64})|HELO[sx0b][-.a-z]{1,255}|MAIL[sx0b]FROM:<.{1,64}@.{1,255}>|R(?:CPT[sx0b]TO:(?:<.{1,64}@.{1,255}>| )?<.{1,64}>|SETb)|VRFY[sx0b].{1,64}(?:[sx0b]<.{1,64}@.{1,255}>|@.{1,255})|AUTH[sx0b][-0-9_a-z]{1,20}[sx0b](?:(?:[+/-9A-Z_a-z]{4})*(?:[+/-9A-Z_a-z]{2}=|[+/-9A-Z_a-z]{3}))?=|STARTTLSb|NOOPb(?:[sx0b].{1,255})?)",
      "category": "rce",
      "severity": "high"
    },
    {
      "id": "932320",
      "name": "Remote Command Execution: POP3 Command Execution",
      "pattern": "(?is)rn.*?b(?:(?:LIST|TOP [0-9]+)(?: [0-9]+)?|U(?:SER .+?|IDL(?: [0-9]+)?)|PASS .+?|(?:RETR|DELE) [0-9]+?|A(?:POP [0-9A-Z_a-z]+ [0-9a-f]{32}|UTH [-0-9_a-z]{1,20} (?:(?:[+/-9A-Z_a-z]{4})*(?:[+/-9A-Z_a-z]{2}=|[+/-9A-Z_a-z]{3}))?=))",
      "category": "rce",
      "severity": "high"
    }
  ]
}