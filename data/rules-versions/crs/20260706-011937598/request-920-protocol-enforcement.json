{
  "pack_id": "request-920-protocol-enforcement",
  "version": "4.25.0",
  "description": "核心规则集 imported from REQUEST-920-PROTOCOL-ENFORCEMENT.conf (regex subset)",
  "enabled": true,
  "rollout_pct": 100,
  "rules": [
    {
      "id": "920170",
      "name": "GET or HEAD Request with Body Content",
      "pattern": "^(?:GET|HEAD)$",
      "category": "protocol",
      "severity": "medium"
    },
    {
      "id": "920171",
      "name": "GET or HEAD Request with Transfer-Encoding",
      "pattern": "^(?:GET|HEAD)$",
      "category": "protocol",
      "severity": "medium"
    },
    {
      "id": "920190",
      "name": "Range: Invalid Last Byte Value",
      "pattern": "(d+)-(d+)",
      "category": "protocol",
      "severity": "medium"
    },
    {
      "id": "920210",
      "name": "Multiple/Conflicting Connection Header Data Found",
      "pattern": "b(?:keep-alive|close),s?(?:keep-alive|close)b",
      "category": "protocol",
      "severity": "medium"
    },
    {
      "id": "920260",
      "name": "Unicode Full/Half Width Abuse Attack Attempt",
      "pattern": "(?i)%uff[0-9a-f]{2}",
      "category": "protocol",
      "severity": "medium"
    },
    {
      "id": "920290",
      "name": "Empty Host Header",
      "pattern": "^$",
      "category": "protocol",
      "severity": "medium"
    },
    {
      "id": "920310",
      "name": "Request Has an Empty Accept Header",
      "pattern": "^$",
      "category": "protocol",
      "severity": "medium"
    },
    {
      "id": "920311",
      "name": "Request Has an Empty Accept Header",
      "pattern": "^$",
      "category": "protocol",
      "severity": "medium"
    },
    {
      "id": "920330",
      "name": "Empty User Agent Header",
      "pattern": "^$",
      "category": "protocol",
      "severity": "medium"
    },
    {
      "id": "920350",
      "name": "Host header is a numeric IP address",
      "pattern": "(?:^([d.]+|[[da-f:]+]|[da-f:]+)(:[d]+)?$)",
      "category": "protocol",
      "severity": "medium"
    },
    {
      "id": "920420",
      "name": "Request content type is not allowed by policy",
      "pattern": "^[^;s]+",
      "category": "protocol",
      "severity": "medium"
    },
    {
      "id": "920480",
      "name": "Request content type charsett is not allowed by policy",
      "pattern": "charsetts*=s*[\"']?([^;\"'s]+)",
      "category": "protocol",
      "severity": "medium"
    },
    {
      "id": "920530",
      "name": "Multiple charsetts detected in content type header",
      "pattern": "charsett.*?charsett",
      "category": "protocol",
      "severity": "medium"
    },
    {
      "id": "920440",
      "name": "URL file extension is restricted by policy",
      "pattern": ".([^.]+)$",
      "category": "protocol",
      "severity": "medium"
    },
    {
      "id": "920500",
      "name": "Attempt to access a backup or working file",
      "pattern": ".[^.~]+~(?:/.*|)$",
      "category": "protocol",
      "severity": "medium"
    },
    {
      "id": "920450",
      "name": "HTTP header is restricted by policy (%{MATCHED_VAR})",
      "pattern": "^.*$",
      "category": "protocol",
      "severity": "medium"
    },
    {
      "id": "920540",
      "name": "Possible Unicode character bypass detected",
      "pattern": "(?i)x5cu[0-9a-f]{4}",
      "category": "protocol",
      "severity": "medium"
    },
    {
      "id": "920200",
      "name": "Range: Too many fields (6 or more)",
      "pattern": "^bytes=(?:(?:d+)?-(?:d+)?s*,?s*){6}",
      "category": "protocol",
      "severity": "medium"
    },
    {
      "id": "920230",
      "name": "Multiple URL Encoding Detected",
      "pattern": "%[0-9a-fA-F]{2}",
      "category": "protocol",
      "severity": "medium"
    },
    {
      "id": "920121",
      "name": "Attempted multipart/form-data bypass",
      "pattern": "['\";=x5c]",
      "category": "protocol",
      "severity": "medium"
    },
    {
      "id": "920451",
      "name": "HTTP header is restricted by policy (%{MATCHED_VAR})",
      "pattern": "^.*$",
      "category": "protocol",
      "severity": "medium"
    },
    {
      "id": "920240",
      "name": "URL Encoding Abuse Attack Attempt",
      "pattern": "^(?i)application/x-www-form-urlencoded",
      "category": "protocol",
      "severity": "medium"
    }
  ]
}