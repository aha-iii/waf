{
  "pack_id": "request-920-protocol-enforcement",
  "version": "4.25.0",
  "description": "核心规则集 imported from REQUEST-920-PROTOCOL-ENFORCEMENT.conf (regex subset)",
  "enabled": true,
  "rollout_pct": 100,
  "rules": [
    {
      "id": "920210",
      "name": "Multiple/Conflicting Connection Header Data Found",
      "pattern": "\\b(?:keep-alive|close),\\s?(?:keep-alive|close)\\b",
      "category": "protocol",
      "severity": "medium",
      "paranoia_level": 1,
      "scan_targets": []
    },
    {
      "id": "920260",
      "name": "Unicode Full/Half Width Abuse Attack Attempt",
      "pattern": "(?i)%uff[0-9a-f]{2}",
      "category": "protocol",
      "severity": "medium",
      "paranoia_level": 1,
      "scan_targets": []
    },
    {
      "id": "920290",
      "name": "Empty Host Header",
      "pattern": "^$",
      "category": "protocol",
      "severity": "medium",
      "paranoia_level": 1,
      "scan_targets": []
    },
    {
      "id": "920330",
      "name": "Empty User Agent Header",
      "pattern": "^$",
      "category": "protocol",
      "severity": "medium",
      "paranoia_level": 1,
      "scan_targets": []
    },
    {
      "id": "920350",
      "name": "Host header is a numeric IP address",
      "pattern": "(?:^([\\d.]+|\\[[\\da-f:]+\\]|[\\da-f:]+)(:[\\d]+)?$)",
      "category": "protocol",
      "severity": "medium",
      "paranoia_level": 1,
      "scan_targets": []
    },
    {
      "id": "920530",
      "name": "Multiple charsetts detected in content type header",
      "pattern": "charsett.*?charsett",
      "category": "protocol",
      "severity": "medium",
      "paranoia_level": 1,
      "scan_targets": []
    },
    {
      "id": "920500",
      "name": "Attempt to access a backup or working file",
      "pattern": "\\.[^.~]+~(?:/.*|)$",
      "category": "protocol",
      "severity": "medium",
      "paranoia_level": 1,
      "scan_targets": []
    },
    {
      "id": "920540",
      "name": "Possible Unicode character bypass detected",
      "pattern": "(?i)\\x5cu[0-9a-f]{4}",
      "category": "protocol",
      "severity": "medium",
      "paranoia_level": 1,
      "scan_targets": []
    },
    {
      "id": "920230",
      "name": "Multiple URL Encoding Detected",
      "pattern": "%[0-9a-fA-F]{2}",
      "category": "protocol",
      "severity": "medium",
      "paranoia_level": 2,
      "scan_targets": []
    },
    {
      "id": "920121",
      "name": "Attempted multipart/form-data bypass",
      "pattern": "['\";=\\x5c]",
      "category": "protocol",
      "severity": "medium",
      "paranoia_level": 2,
      "scan_targets": []
    }
  ]
}