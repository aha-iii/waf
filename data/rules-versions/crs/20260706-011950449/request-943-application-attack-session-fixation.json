{
  "pack_id": "request-943-application-attack-session-fixation",
  "version": "4.25.0",
  "description": "核心规则集 imported from REQUEST-943-APPLICATION-ATTACK-SESSION-FIXATION.conf (regex subset)",
  "enabled": true,
  "rollout_pct": 100,
  "rules": [
    {
      "id": "943100",
      "name": "Possible Session Fixation Attack: Setting Cookie Values in HTML",
      "pattern": "(?i)\\.cookie\\b.*?;[^0-9A-Z_a-z]*?(?:expires|domain)[^0-9A-Z_a-z]*?=|\\bhttp-equiv[^0-9A-Z_a-z]+set-cookie\\b",
      "category": "session",
      "severity": "medium",
      "paranoia_level": 1,
      "scan_targets": []
    }
  ]
}