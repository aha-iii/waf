{
  "pack_id": "request-944-application-attack-java",
  "version": "4.25.0",
  "description": "核心规则集 imported from REQUEST-944-APPLICATION-ATTACK-JAVA.conf (regex subset)",
  "enabled": true,
  "rollout_pct": 100,
  "rules": [
    {
      "id": "944100",
      "name": "Remote Command Execution: Suspicious Java class detected",
      "pattern": "java\\.lang\\.(?:runtime|processbuilder)",
      "category": "rce",
      "severity": "critical",
      "paranoia_level": 1,
      "scan_targets": [
        "ARGS",
        "ARGS_NAMES",
        "COOKIES",
        "COOKIE_NAMES",
        "BODY"
      ]
    },
    {
      "id": "944110",
      "name": "Remote Command Execution: Java process spawn (CVE-2017-9805)",
      "pattern": "(?:runtime|processbuilder)",
      "category": "rce",
      "severity": "critical",
      "paranoia_level": 1,
      "scan_targets": [
        "ARGS",
        "ARGS_NAMES",
        "COOKIES",
        "COOKIE_NAMES",
        "BODY"
      ]
    },
    {
      "id": "944120",
      "name": "Remote Command Execution: Java serialization (CVE-2015-4852)",
      "pattern": "(?:clonetransform|xmldecod)er|f(?:orclosure|ilewriter)|in(?:stantiate(?:factory|transformer)|vokertransformer)|(?:prototype(?:clone|serialization)factor|getpropert)y|whileclosure",
      "category": "rce",
      "severity": "critical",
      "paranoia_level": 1,
      "scan_targets": [
        "ARGS",
        "ARGS_NAMES",
        "COOKIES",
        "COOKIE_NAMES",
        "BODY"
      ]
    },
    {
      "id": "944140",
      "name": "Java Injection Attack: Java Script File Upload Found",
      "pattern": ".*\\.(?:jsp|jspx)\\.*$",
      "category": "misc",
      "severity": "medium",
      "paranoia_level": 1,
      "scan_targets": []
    },
    {
      "id": "944150",
      "name": "Potential Remote Command Execution: Log4j / Log4shell",
      "pattern": "(?i)(?:\\$|&dollar;?)(?:\\{|&l(?:brace|cub);?)(?:[^\\}]{0,15}(?:\\$|&dollar;?)(?:\\{|&l(?:brace|cub);?)|jndi|ctx)",
      "category": "rce",
      "severity": "critical",
      "paranoia_level": 1,
      "scan_targets": [
        "ARGS",
        "ARGS_NAMES",
        "COOKIES",
        "COOKIE_NAMES",
        "BODY"
      ]
    },
    {
      "id": "944151",
      "name": "Potential Remote Command Execution: Log4j / Log4shell",
      "pattern": "(?i)(?:\\$|&dollar;?)(?:\\{|&l(?:brace|cub);?)(?:[^\\}]*(?:\\$|&dollar;?)(?:\\{|&l(?:brace|cub);?)|jndi|ctx)",
      "category": "rce",
      "severity": "high",
      "paranoia_level": 2,
      "scan_targets": [
        "ARGS",
        "ARGS_NAMES",
        "COOKIES",
        "COOKIE_NAMES",
        "BODY"
      ]
    },
    {
      "id": "944200",
      "name": "Magic bytes Detected, probable java serialization in use",
      "pattern": "\\xac\\xed\\x00\\x05",
      "category": "rce",
      "severity": "high",
      "paranoia_level": 2,
      "scan_targets": [
        "ARGS",
        "ARGS_NAMES",
        "COOKIES",
        "COOKIE_NAMES",
        "BODY"
      ]
    },
    {
      "id": "944210",
      "name": "Magic bytes Detected Base64 Encoded, probable java serialization in use",
      "pattern": "(?:rO0ABQ|KztAAU|Cs7QAF)",
      "category": "rce",
      "severity": "high",
      "paranoia_level": 2,
      "scan_targets": [
        "ARGS",
        "ARGS_NAMES",
        "COOKIES",
        "COOKIE_NAMES",
        "BODY"
      ]
    },
    {
      "id": "944240",
      "name": "Remote Command Execution: Java serialization (CVE-2015-4852)",
      "pattern": "(?:clonetransform|xmldecod)er|f(?:orclosure|ilewriter)|in(?:stantiate(?:factory|transformer)|vokertransformer)|(?:prototype(?:clone|serialization)factor|getpropert)y|whileclosure",
      "category": "rce",
      "severity": "high",
      "paranoia_level": 2,
      "scan_targets": [
        "ARGS",
        "ARGS_NAMES",
        "COOKIES",
        "COOKIE_NAMES",
        "BODY"
      ]
    },
    {
      "id": "944250",
      "name": "Remote Command Execution: Suspicious Java method detected",
      "pattern": "java\\b.+(?:runtime|processbuilder)",
      "category": "rce",
      "severity": "high",
      "paranoia_level": 2,
      "scan_targets": [
        "ARGS",
        "ARGS_NAMES",
        "COOKIES",
        "COOKIE_NAMES",
        "BODY"
      ]
    },
    {
      "id": "944260",
      "name": "Remote Command Execution: Malicious class-loading payload",
      "pattern": "class\\.module\\.classLoader\\.resources\\.context\\.parent\\.pipeline|springframework\\.context\\.support\\.FileSystemXmlApplicationContext",
      "category": "rce",
      "severity": "high",
      "paranoia_level": 2,
      "scan_targets": [
        "ARGS",
        "ARGS_NAMES",
        "COOKIES",
        "COOKIE_NAMES",
        "BODY"
      ]
    }
  ]
}