{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@nerve/ui": ["./vendor/nerve-ui/src/index.ts"],
      "@nerve/ui/style.css": ["./vendor/nerve-ui/src/styles/index.css"]
    }
  },
  "include": ["src"],
  "exclude": ["src/_legacy", "src/**/*.test.ts", "node_modules", "dist"]
}
