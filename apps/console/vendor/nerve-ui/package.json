{
  "name": "@nerve/ui",
  "version": "0.1.0",
  "description": "Nerve React UI kit — nerve-form / nerve-table / nerve-input … 独立可发布",
  "type": "module",
  "main": "./dist/nerve-ui.cjs",
  "module": "./dist/nerve-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nerve-ui.js",
      "require": "./dist/nerve-ui.cjs"
    },
    "./style.css": "./dist/nerve-ui.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:lib": "vite build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "preview": "vite preview --config playground/vite.config.ts"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.0",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^3.9.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "restricted"
  }
}
